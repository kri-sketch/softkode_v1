Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # 1. Force HTTPS
  # This ensures consistent secure connections and prevents "stuck" HTTP requests
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. React Router Support
  # Redirects all traffic to index.html so React can handle the routing
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Optional: Enable Basic Browser Caching for Performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
